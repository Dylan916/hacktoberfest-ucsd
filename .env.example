# ==============================================================================
# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# ==============================================================================
# Used by @google/genai SDK (recommended for server-side / route handlers)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Override the hosted Gemma model (Gemma 4 IT model IDs are supported)
GEMMA_MODEL=gemma-4-26b-a4b-it

# (Optional) Local offline inference via Ollama's chat API
NEXT_PUBLIC_LOCAL_GEMMA_URL=http://localhost:11434/api/chat
NEXT_PUBLIC_LOCAL_GEMMA_MODEL=gemma4:latest

# (Optional) Supabase credentials if using Supabase features:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
